# Insight Flow — configuration reference. PLACEHOLDERS ONLY. Never put real values in this file or commit a .env.
# Locally, set secrets with AppHost user-secrets (see README); in Azure they are secure deployment parameters / Key Vault.

# AI providers (optional locally; unset providers are disabled)
Parameters__azure-openai-endpoint=https://<resource>.openai.azure.com/openai/v1/
Parameters__azure-openai-api-key=<azure-openai-key>
Parameters__anthropic-api-key=<anthropic-key>
