{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Mode": "Entra",
    "TenantClaimType": "tenant_id",
    "UserIdClaimType": "sub",
    "RoleClaimType": "roles"
  },
  "AzureAd": {
    "Instance": "https://<your-external-tenant>.ciamlogin.com/",
    "TenantId": "<entra-external-id-tenant-guid>",
    "ClientId": "<insightflow-api-app-client-id>",
    "Audience": "api://<insightflow-api-app-client-id>"
  }
}
