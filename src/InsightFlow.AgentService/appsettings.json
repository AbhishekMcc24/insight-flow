{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.Extensions.AI": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Mode": "Entra",
    "TenantClaimType": "tenant_id",
    "UserIdClaimType": "sub",
    "RoleClaimType": "roles"
  },
  "AzureAd": {
    "Instance": "https://<your-external-tenant>.ciamlogin.com/",
    "TenantId": "<entra-external-id-tenant-guid>",
    "ClientId": "<insightflow-api-app-client-id>",
    "Audience": "api://<insightflow-api-app-client-id>"
  },
  "Ai": {
    "AzureOpenAI": {
      "Deployments": { "small": "gpt-5-mini", "large": "gpt-5" }
    },
    "Anthropic": {
      "Models": { "small": "claude-haiku-4-5", "large": "claude-opus-5-5" }
    },
    "Routes": {
      "Routing": "anthropic:small",
      "SqlGeneration": "anthropic:large",
      "ChartRecommendation": "anthropic:large",
      "InsightSummary": "anthropic:large"
    },
    "DefaultMonthlyTokenBudget": 5000000
  }
}
