<Project Sdk="Aspire.AppHost.Sdk/13.6.1">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>insightflow-apphost-6f3c2a1e</UserSecretsId>
    <!-- Resolve DCP and the dashboard from NuGet (deterministic; CI and Aspire.Hosting.Testing need no installed CLI).
         ASPIRE010 only advertises the optional CLI bundle. See docs/adr/0021-aspire-nuget-dcp.md. -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Azure.AppContainers" />
    <PackageReference Include="Aspire.Hosting.Azure.KeyVault" />
    <PackageReference Include="Aspire.Hosting.Azure.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.Azure.Redis" />
    <PackageReference Include="Aspire.Hosting.Azure.Storage" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InsightFlow.MigrationService\InsightFlow.MigrationService.csproj" />
    <ProjectReference Include="..\InsightFlow.QueryService\InsightFlow.QueryService.csproj" />
    <ProjectReference Include="..\InsightFlow.AgentService\InsightFlow.AgentService.csproj" />
    <ProjectReference Include="..\InsightFlow.Api\InsightFlow.Api.csproj" />
    <ProjectReference Include="..\InsightFlow.Worker\InsightFlow.Worker.csproj" />
    <ProjectReference Include="..\InsightFlow.Web\InsightFlow.Web.csproj" />
  </ItemGroup>

</Project>
