<Project Sdk="Microsoft.NET.Sdk.Worker">
  <!-- Quartz.NET background jobs: extract refresh (queue), schedules, subscriptions, alerts, exports. Owned by Developer 2 after handoff. -->
  <PropertyGroup>
    <UserSecretsId>insightflow-worker-4e1a</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\InsightFlow.Connectors\InsightFlow.Connectors.csproj" />
    <ProjectReference Include="..\InsightFlow.Persistence\InsightFlow.Persistence.csproj" />
    <ProjectReference Include="..\InsightFlow.ServiceDefaults\InsightFlow.ServiceDefaults.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Azure.Security.KeyVault" />
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Quartz" />
    <PackageReference Include="Quartz.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <!-- 5,000 deterministic retail rows (generated by RetailDataGenerator) seeded into the dev tenant's Sample Data folder. -->
    <EmbeddedResource Include="..\..\samples\retail_sales.csv" LogicalName="InsightFlow.Worker.Samples.retail_sales.csv" />
  </ItemGroup>
</Project>
