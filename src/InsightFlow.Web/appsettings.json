{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Mode": "Entra",
    "TenantClaimType": "tenant_id",
    "UserIdClaimType": "sub",
    "RoleClaimType": "roles"
  },
  "AzureAd": {
    "Instance": "https://<your-external-tenant>.ciamlogin.com/",
    "TenantId": "<entra-external-id-tenant-guid>",
    "ClientId": "<insightflow-web-app-client-id>",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  },
  "DownstreamApi": {
    "Scopes": [ "api://<insightflow-api-app-client-id>/access_as_user" ]
  }
}
