@using System.Globalization
@implements IDisposable
@inject QueryApiClient Query
@* The vertical slice: pick mark + fields for a dataset version → VizSpec → QueryService → Vega-Lite.
   TODO(dev2): drag fields from the Data pane onto shelves, filters UI, saved charts (workbooks). *@

<div class="flex h-full min-h-0 flex-col gap-3 p-3">
    @if (DatasetVersionId is null)
    {
        <EmptyState Title="No dataset selected">
            Choose a dataset, or open one from the Explorer.
        </EmptyState>
    }
    else
    {
        <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 xl:grid-cols-6">
            <label>
                <span class="@UiStyles.Label">Mark</span>
                <select class="@UiStyles.Input" value="@_mark" @onchange="e => SetAsync(() => _mark = Enum.Parse<Mark>((string)e.Value!))" aria-label="Mark">
                    @foreach (var mark in Enum.GetValues<Mark>())
                    {
                        <option value="@mark">@mark</option>
                    }
                </select>
            </label>
            <label>
                <span class="@UiStyles.Label">@(_mark == Mark.Pie ? "Category" : "X")</span>
                <select class="@UiStyles.Input" value="@_x" @onchange="e => SetAsync(() => _x = (string)e.Value!)" aria-label="X field">
                    <option value="">—</option>
                    @foreach (var c in _columns)
                    {
                        <option value="@c.Name">@c.Name</option>
                    }
                </select>
            </label>
            <label>
                <span class="@UiStyles.Label">Time unit</span>
                <select class="@UiStyles.Input" value="@(_timeUnit?.ToString() ?? "")" disabled="@(!IsDate(_x))" aria-label="Time unit"
                        @onchange="e => SetAsync(() => _timeUnit = string.IsNullOrEmpty((string?)e.Value) ? null : Enum.Parse<TimeUnit>((string)e.Value!))">
                    <option value="">None</option>
                    @foreach (var unit in Enum.GetValues<TimeUnit>())
                    {
                        <option value="@unit">@unit</option>
                    }
                </select>
            </label>
            <label>
                <span class="@UiStyles.Label">@(_mark == Mark.Pie ? "Value" : "Y")</span>
                <select class="@UiStyles.Input" value="@_y" @onchange="e => SetAsync(() => _y = (string)e.Value!)" aria-label="Y field">
                    <option value="">—</option>
                    @foreach (var c in _columns)
                    {
                        <option value="@c.Name">@c.Name</option>
                    }
                </select>
            </label>
            <label>
                <span class="@UiStyles.Label">Aggregate</span>
                <select class="@UiStyles.Input" value="@_yAgg" @onchange="e => SetAsync(() => _yAgg = Enum.Parse<Agg>((string)e.Value!))" aria-label="Y aggregate">
                    @foreach (var agg in Enum.GetValues<Agg>())
                    {
                        <option value="@agg">@agg</option>
                    }
                </select>
            </label>
            <label>
                <span class="@UiStyles.Label">@(_mark == Mark.Heatmap ? "Color (measure)" : "Color")</span>
                <select class="@UiStyles.Input" value="@_color" @onchange="e => SetAsync(() => _color = (string)e.Value!)" aria-label="Color field">
                    <option value="">—</option>
                    @foreach (var c in _columns)
                    {
                        <option value="@c.Name">@c.Name</option>
                    }
                </select>
            </label>
        </div>

        <div class="flex flex-wrap items-center gap-2 text-xs">
            <label class="flex items-center gap-1.5 text-slate-600 dark:text-slate-300">
                Sort
                <select class="rounded border border-slate-300 bg-white px-1.5 py-0.5 dark:border-slate-700 dark:bg-slate-900" value="@_sort" aria-label="Sort"
                        @onchange="e => SetAsync(() => _sort = (string)e.Value!)">
                    <option value="">Default</option>
                    <option value="desc">Value ↓</option>
                    <option value="asc">Value ↑</option>
                </select>
            </label>
            @if (_response is not null)
            {
                <span class="@UiStyles.Badge">@_response.Result.Rows.Count.ToString("N0", CultureInfo.CurrentCulture) rows@(_response.Result.Truncated ? "+" : "")</span>
                <span class="@UiStyles.Badge">@_response.DurationMs.ToString("0", CultureInfo.InvariantCulture) ms</span>
                @if (_response.FromCache)
                {
                    <span class="@UiStyles.Badge bg-emerald-100 text-emerald-700 dark:bg-emerald-900/50 dark:text-emerald-200" data-testid="cache-hit">cached</span>
                }
            }
            @if (_loading)
            {
                <Spinner Small="true" Class="text-brand-600" />
            }
        </div>

        <Alert Message="@_error" />

        <div class="relative min-h-72 flex-1 rounded-lg border border-slate-200 bg-white p-3 dark:border-slate-800 dark:bg-slate-900" data-testid="chart-canvas">
            @if (_response is not null && _spec is not null)
            {
                <VizRenderer Spec="_spec" Result="_response.Result" Class="h-full" />
            }
            else if (!_loading)
            {
                <EmptyState Title="Pick fields to build a chart" />
            }
        </div>

        @if (_response is not null)
        {
            <details class="rounded-md border border-slate-200 text-xs dark:border-slate-800">
                <summary class="cursor-pointer px-3 py-1.5 font-medium text-slate-600 dark:text-slate-300">SQL</summary>
                <pre class="overflow-auto bg-slate-50 px-3 py-2 font-mono text-[11px] leading-relaxed dark:bg-slate-950" data-testid="chart-sql">@_response.Sql</pre>
            </details>
        }
    }
</div>

@code {
    private IReadOnlyList<QueryColumn> _columns = [];
    private Guid? _loadedDataset;
    private Mark _mark = Mark.Bar;
    private string _x = "", _y = "", _color = "", _sort = "";
    private TimeUnit? _timeUnit;
    private Agg _yAgg = Agg.Sum;
    private VizSpec? _spec;
    private VizQueryResponse? _response;
    private bool _loading;
    private string? _error;
    private CancellationTokenSource? _cts;

    [Parameter] public Guid? DatasetVersionId { get; set; }

    /// <summary>Raised when the dataset's columns are known (the Data pane lists them).</summary>
    [Parameter] public EventCallback<IReadOnlyList<QueryColumn>> ColumnsChanged { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (DatasetVersionId == _loadedDataset)
        {
            return;
        }

        _loadedDataset = DatasetVersionId;
        _response = null;
        _spec = null;
        _columns = [];
        if (DatasetVersionId is not { } id)
        {
            return;
        }

        _loading = true;
        try
        {
            var preview = await Query.PreviewAsync(id, 1, CancellationToken.None);
            _columns = preview.Result.Columns;
            await ColumnsChanged.InvokeAsync(_columns);
            ChooseDefaults();
            await RunAsync();
        }
        catch (ServiceCallException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>Loads a spec produced elsewhere (e.g. an analyst chart proposal) into the controls and runs it.</summary>
    public async Task ApplySpecAsync(VizSpec spec)
    {
        ArgumentNullException.ThrowIfNull(spec);
        _mark = spec.Mark;
        var category = spec.Mark == Mark.Pie ? spec.Encoding.Color : spec.Encoding.X;
        _x = category?.Field ?? "";
        _timeUnit = category?.TimeUnit;
        _y = spec.Encoding.Y?.Field ?? "";
        _yAgg = spec.Encoding.Y?.Agg ?? Agg.None;
        _color = spec.Mark == Mark.Pie ? "" : spec.Encoding.Color?.Field ?? "";
        _sort = spec.Sort is [{ } s] && s.Field == _y ? (s.Direction == SortDirection.Desc ? "desc" : "asc") : "";
        await RunAsync();
        StateHasChanged();
    }

    private void ChooseDefaults()
    {
        var category = _columns.FirstOrDefault(c => c.Type == ColumnType.String);
        var measure = _columns.FirstOrDefault(c => c.Type is ColumnType.Number) ?? _columns.FirstOrDefault(c => c.Type is ColumnType.Integer);
        _mark = Mark.Bar;
        _x = category?.Name ?? _columns.FirstOrDefault()?.Name ?? "";
        _y = measure?.Name ?? "";
        _yAgg = measure is null ? Agg.Count : Agg.Sum;
        _color = "";
        _timeUnit = null;
        _sort = "desc";
    }

    private bool IsDate(string column) => _columns.FirstOrDefault(c => c.Name == column)?.Type is ColumnType.Date or ColumnType.DateTime;

    private async Task SetAsync(Action change)
    {
        change();
        if (!IsDate(_x))
        {
            _timeUnit = null;
        }

        await RunAsync();
    }

    private VizSpec? BuildSpec()
    {
        if (DatasetVersionId is not { } id)
        {
            return null;
        }

        FieldRef? Ref(string name, Agg agg = Agg.None, TimeUnit? unit = null) =>
            string.IsNullOrEmpty(name) ? null : new FieldRef(name, agg, unit);

        var category = Ref(_x, unit: _timeUnit);
        var value = Ref(_y, _yAgg);
        var encoding = _mark switch
        {
            Mark.Pie => new VizEncoding(X: null, Y: value, Color: category),
            Mark.Heatmap => new VizEncoding(category, Ref(_y), Ref(_color, _yAgg == Agg.None ? Agg.Sum : _yAgg)),
            _ => new VizEncoding(category, value, Ref(_color)),
        };
        var sortField = _mark == Mark.Heatmap ? null : value;
        IReadOnlyList<SortSpec>? sort = _sort.Length > 0 && sortField is not null && category?.TimeUnit is null
            ? [new SortSpec(sortField.Field, _sort == "desc" ? SortDirection.Desc : SortDirection.Asc)]
            : null;
        return new VizSpec(VizSpec.CurrentSchemaVersion, id, _mark, encoding, [], sort);
    }

    private async Task RunAsync()
    {
        var spec = BuildSpec();
        if (spec is null)
        {
            return;
        }

        if (_cts is not null)
        {
            await _cts.CancelAsync();
            _cts.Dispose();
        }

        _cts = new CancellationTokenSource();
        var ct = _cts.Token;
        _loading = true;
        _error = null;
        try
        {
            var response = await Query.VizAsync(new VizQueryRequest(spec), ct);
            _spec = spec;
            _response = response;
        }
        catch (ServiceCallException ex)
        {
            _error = ex.Message;
            _response = null;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // A newer request superseded this one.
        }
        finally
        {
            if (!ct.IsCancellationRequested)
            {
                _loading = false;
            }
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
