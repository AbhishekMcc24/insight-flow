@implements IAsyncDisposable
@inject WorkspaceApiClient Workspace
@inject IJSRuntime JS
@* Workspace Explorer: My Workspace + Shared trees, OS drag-and-drop of files/folders (explorerDrop.js → BFF streaming
   upload), drag-to-move, and context actions. All tree state lives here; ExplorerFolderNode only renders it.
   TODO(dev2): trash/restore, sharing, search, multi-select, keyboard navigation, live refresh on concurrent changes. *@

<div class="flex h-full min-h-0 flex-col" @ref="_root" data-testid="explorer">
    @* Context toolbar *@
    <div class="flex flex-wrap items-center gap-1 border-b border-slate-200 px-2 py-1.5 dark:border-slate-800">
        @if (_mode == Mode.NewFolder || _mode == Mode.Rename)
        {
            <form class="flex w-full items-center gap-1" @onsubmit="SubmitNameAsync">
                <input class="@UiStyles.Input py-1 text-xs" @bind="_nameInput" @ref="_nameInputRef" aria-label="@(_mode == Mode.NewFolder ? "New folder name" : "New name")" placeholder="Name" maxlength="255" />
                <Button Small="true" Variant="ButtonVariant.Primary" Type="submit" Busy="_busy">OK</Button>
                <Button Small="true" Variant="ButtonVariant.Ghost" OnClick="Cancel">Cancel</Button>
            </form>
        }
        else if (_mode == Mode.ConfirmDelete)
        {
            <span class="flex-1 truncate text-xs">Delete “@SelectedName”?</span>
            <Button Small="true" Variant="ButtonVariant.Danger" Busy="_busy" OnClick="DeleteAsync">Delete</Button>
            <Button Small="true" Variant="ButtonVariant.Ghost" OnClick="Cancel">Cancel</Button>
        }
        else
        {
            <Button Small="true" Variant="ButtonVariant.Ghost" Title="New folder" Disabled="!CanWriteTarget" OnClick="StartNewFolder">+ Folder</Button>
            <Button Small="true" Variant="ButtonVariant.Ghost" Title="Upload files" Disabled="!CanWriteTarget" OnClick="() => PickAsync(_fileInput)">Upload</Button>
            <Button Small="true" Variant="ButtonVariant.Ghost" Title="Upload a folder" Disabled="!CanWriteTarget" OnClick="() => PickAsync(_dirInput)">Folder…</Button>
            @if (_selectedItem is { } item)
            {
                <span class="mx-1 h-4 w-px bg-slate-200 dark:bg-slate-700"></span>
                @if (item.Kind == "Dataset")
                {
                    <Button Small="true" Variant="ButtonVariant.Primary" OnClick="() => OpenAsync(item)">Open</Button>
                }
                @if (item.CanCreateDataset)
                {
                    <Button Small="true" Variant="ButtonVariant.Primary" Busy="JobStatus(item.Id) is not null" OnClick="() => CreateDatasetAsync(item)">Create dataset</Button>
                }
                @if (item.Kind == "File")
                {
                    <a class="rounded-md px-2 py-1 text-xs font-medium text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800"
                       href="bff/workspace/items/@item.Id/content" download>Download</a>
                }
            }
            @if (CanRenameOrDelete)
            {
                <Button Small="true" Variant="ButtonVariant.Ghost" OnClick="StartRename">Rename</Button>
                <Button Small="true" Variant="ButtonVariant.Ghost" OnClick="() => _mode = Mode.ConfirmDelete">Delete</Button>
            }
        }
    </div>

    <div class="space-y-1 px-2 pt-2">
        <Alert Message="@_error" OnDismiss="() => _error = null" />
        <Alert Message="@_info" Error="false" OnDismiss="() => _info = null" />
    </div>

    @* Tree (also the OS drop zone) *@
    <div class="min-h-0 flex-1 overflow-auto px-1 py-1" data-testid="explorer-tree">
        @if (_roots is null)
        {
            <div class="flex justify-center p-4"><Spinner Class="text-slate-400" /></div>
        }
        else
        {
            <ul role="tree" aria-label="Workspace">
                <ExplorerFolderNode Folder="_roots.MyWorkspace" Owner="this" />
                <ExplorerFolderNode Folder="_roots.Shared" Owner="this" />
            </ul>
            <p class="px-2 pt-3 text-xs text-slate-400">Drag files or folders from your computer onto a folder to upload.</p>
        }
    </div>

    @* Upload progress *@
    @if (_uploads.Count > 0)
    {
        <div class="max-h-48 shrink-0 overflow-auto border-t border-slate-200 px-2 py-2 dark:border-slate-800" data-testid="uploads">
            <div class="mb-1 flex items-center text-xs font-medium text-slate-500">
                <span class="flex-1">Uploads (@_uploads.Count(u => u.Done)/@_uploads.Count)</span>
                @if (_uploads.All(u => u.Done))
                {
                    <button type="button" class="hover:text-slate-800 dark:hover:text-slate-200" @onclick="() => _uploads.Clear()">Clear</button>
                }
            </div>
            <ul class="space-y-1.5">
                @foreach (var upload in _uploads)
                {
                    <li class="text-xs" @key="upload.Id">
                        <div class="flex gap-2">
                            <span class="flex-1 truncate" title="@upload.Path">@upload.Path</span>
                            <span class="shrink-0 @(upload.Done && !upload.Success ? "text-red-600" : "text-slate-500")">
                                @(upload.Done ? (upload.Success ? "✓" : "failed") : $"{upload.Percent}%")
                            </span>
                        </div>
                        <div class="mt-0.5 h-1 overflow-hidden rounded bg-slate-200 dark:bg-slate-700">
                            <div class="h-full transition-all @(upload.Done && !upload.Success ? "bg-red-500" : "bg-brand-500")" style="width: @(upload.Percent)%"></div>
                        </div>
                        @if (upload.Error is { } uploadError)
                        {
                            <p class="mt-0.5 text-red-600">@uploadError</p>
                        }
                    </li>
                }
            </ul>
        </div>
    }

    <input type="file" multiple hidden @ref="_fileInput" />
    <input type="file" multiple webkitdirectory hidden @ref="_dirInput" />
</div>

@code {
    private enum Mode { Browse, NewFolder, Rename, ConfirmDelete }

    private ElementReference _root, _fileInput, _dirInput, _nameInputRef;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ExplorerPane>? _self;

    private WorkspaceRootsResponse? _roots;
    private readonly Dictionary<Guid, FolderContentsResponse> _contents = [];
    private readonly Dictionary<Guid, FolderDto> _folders = [];
    private readonly HashSet<Guid> _expanded = [];
    private readonly HashSet<Guid> _loading = [];
    private readonly Dictionary<Guid, string> _jobs = [];
    private readonly List<UploadRow> _uploads = [];

    private FolderDto? _selectedFolder;
    private ContentItemDto? _selectedItem;
    private DragPayload? _drag;
    private Guid? _dragOver;
    private Mode _mode;
    private string _nameInput = "";
    private bool _busy;
    private string? _error, _info;

    /// <summary>Raised when the user opens a dataset (double-click or "Open").</summary>
    [Parameter] public EventCallback<DatasetSelection> OnOpenDataset { get; set; }

    // ----- Queries used by ExplorerFolderNode -----
    // Note: node event handlers re-render only the node, so every public mutator below calls StateHasChanged() on the pane.

    public bool IsExpanded(Guid folderId) => _expanded.Contains(folderId);

    public bool IsLoading(Guid folderId) => _loading.Contains(folderId);

    public FolderContentsResponse? ContentsOf(Guid folderId) => _contents.GetValueOrDefault(folderId);

    public bool IsSelected(Guid id) => _selectedItem?.Id == id || (_selectedItem is null && _selectedFolder?.Id == id);

    public bool IsDragging => _drag is not null;

    public bool IsDragTarget(Guid folderId) => _drag is not null && _dragOver == folderId;

    public string? JobStatus(Guid itemId) => _jobs.GetValueOrDefault(itemId);

    /// <summary>The folder new content goes into: the selected folder, else the selected item's folder, else My Workspace.</summary>
    private FolderDto? TargetFolder =>
        _selectedItem is { } item ? _folders.GetValueOrDefault(item.FolderId) : _selectedFolder ?? _roots?.MyWorkspace;

    private bool CanWriteTarget => TargetFolder?.CanWrite == true;

    private bool CanRenameOrDelete =>
        _selectedItem is { } item ? _folders.GetValueOrDefault(item.FolderId)?.CanWrite == true
        : _selectedFolder is { ParentId: not null, CanWrite: true };

    private string SelectedName => _selectedItem?.Name ?? _selectedFolder?.Name ?? "";

    // ----- Lifecycle -----

    protected override async Task OnInitializedAsync()
    {
        await RunAsync(async () =>
        {
            _roots = await Workspace.GetRootsAsync(CancellationToken.None);
            _folders[_roots.MyWorkspace.Id] = _roots.MyWorkspace;
            _folders[_roots.Shared.Id] = _roots.Shared;
            _selectedFolder = _roots.MyWorkspace;
            await ExpandAsync(_roots.MyWorkspace.Id);
            await ExpandAsync(_roots.Shared.Id);
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_module is null && _roots is not null)
        {
            _self = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/explorerDrop.js");
            await _module.InvokeVoidAsync("init", _root, _self);
            await SyncDefaultFolderAsync();
        }

        if (_mode is Mode.NewFolder or Mode.Rename)
        {
            await _nameInputRef.FocusAsync();
        }
    }

    // ----- Tree navigation -----

    public async Task ToggleAsync(FolderDto folder)
    {
        if (!_expanded.Remove(folder.Id))
        {
            await RunAsync(() => ExpandAsync(folder.Id));
        }

        StateHasChanged();
    }

    public async Task SelectFolderAsync(FolderDto folder)
    {
        _selectedFolder = folder;
        _selectedItem = null;
        _mode = Mode.Browse;
        await SyncDefaultFolderAsync();
        if (!_expanded.Contains(folder.Id))
        {
            await RunAsync(() => ExpandAsync(folder.Id));
        }

        StateHasChanged();
    }

    public void SelectItem(ContentItemDto item)
    {
        _selectedItem = item;
        _selectedFolder = _folders.GetValueOrDefault(item.FolderId);
        _mode = Mode.Browse;
        StateHasChanged();
    }

    public async Task OpenAsync(ContentItemDto item)
    {
        if (item.Kind == "Dataset")
        {
            await OnOpenDataset.InvokeAsync(new DatasetSelection(item.TargetId, item.Name));
        }
    }

    private async Task ExpandAsync(Guid folderId)
    {
        _expanded.Add(folderId);
        await LoadAsync(folderId);
    }

    private async Task LoadAsync(Guid folderId)
    {
        _loading.Add(folderId);
        try
        {
            var contents = await Workspace.GetFolderAsync(folderId, CancellationToken.None);
            _contents[folderId] = contents;
            _folders[folderId] = contents.Folder;
            foreach (var child in contents.Folders)
            {
                _folders[child.Id] = child;
            }

            if (_selectedItem is { } selected && selected.FolderId == folderId)
            {
                _selectedItem = contents.Items.FirstOrDefault(i => i.Id == selected.Id);
            }
        }
        finally
        {
            _loading.Remove(folderId);
        }
    }

    /// <summary>Reloads every expanded folder (cheap at reference scale; keeps nested uploads and moves consistent).</summary>
    private async Task RefreshExpandedAsync()
    {
        foreach (var id in _contents.Keys.Where(id => !_expanded.Contains(id)).ToList())
        {
            _contents.Remove(id);
        }

        foreach (var id in _expanded.ToList())
        {
            try
            {
                await LoadAsync(id);
            }
            catch (ServiceCallException)
            {
                _expanded.Remove(id); // deleted or moved away
                _contents.Remove(id);
            }
        }
    }

    // ----- Create / rename / delete -----

    private void StartNewFolder()
    {
        _mode = Mode.NewFolder;
        _nameInput = "New folder";
    }

    private void StartRename()
    {
        _mode = Mode.Rename;
        _nameInput = SelectedName;
    }

    private void Cancel() => _mode = Mode.Browse;

    private async Task SubmitNameAsync()
    {
        var name = _nameInput.Trim();
        if (name.Length == 0)
        {
            return;
        }

        await RunAsync(async () =>
        {
            if (_mode == Mode.NewFolder && TargetFolder is { } parent)
            {
                var created = await Workspace.CreateFolderAsync(parent.Id, name, CancellationToken.None);
                _expanded.Add(parent.Id);
                await LoadAsync(parent.Id);
                _selectedItem = null;
                _selectedFolder = created;
                await SyncDefaultFolderAsync();
            }
            else if (_selectedItem is { } item)
            {
                await Workspace.RenameItemAsync(item.Id, name, CancellationToken.None);
                await LoadAsync(item.FolderId);
            }
            else if (_selectedFolder is { ParentId: { } parentId } folder)
            {
                _selectedFolder = await Workspace.RenameFolderAsync(folder.Id, name, CancellationToken.None);
                await LoadAsync(parentId);
            }

            _mode = Mode.Browse;
        });
    }

    private async Task DeleteAsync()
    {
        await RunAsync(async () =>
        {
            if (_selectedItem is { } item)
            {
                await Workspace.DeleteItemAsync(item.Id, CancellationToken.None);
                _selectedItem = null;
                await LoadAsync(item.FolderId);
            }
            else if (_selectedFolder is { ParentId: { } parentId } folder)
            {
                await Workspace.DeleteFolderAsync(folder.Id, CancellationToken.None);
                _expanded.Remove(folder.Id);
                _contents.Remove(folder.Id);
                _selectedFolder = _folders.GetValueOrDefault(parentId);
                await LoadAsync(parentId);
                await SyncDefaultFolderAsync();
            }

            _mode = Mode.Browse;
        });
    }

    // ----- Create dataset (queue extract, poll the run) -----

    private async Task CreateDatasetAsync(ContentItemDto file)
    {
        _jobs[file.Id] = "Queued…";
        try
        {
            var queued = await Workspace.CreateDatasetAsync(file.Id, CancellationToken.None);
            var deadline = DateTimeOffset.UtcNow.AddMinutes(5);
            ExtractRunDto run;
            do
            {
                await Task.Delay(TimeSpan.FromSeconds(1));
                run = await Workspace.GetExtractRunAsync(queued.RunId, CancellationToken.None);
                _jobs[file.Id] = run.Status == "Running" ? "Extracting…" : "Queued…";
                StateHasChanged();
            }
            while (run.Status is "Pending" or "Running" && DateTimeOffset.UtcNow < deadline);

            if (run.Status == "Succeeded")
            {
                await LoadAsync(file.FolderId);
                _info = $"Dataset created from {file.Name} ({run.RowCount:N0} rows). Double-click it to open.";
                if (run.ContentItemId is { } datasetItemId && ContentsOf(file.FolderId)?.Items.FirstOrDefault(i => i.Id == datasetItemId) is { } dataset)
                {
                    SelectItem(dataset);
                }
            }
            else
            {
                _error = run.Error ?? "The extract did not finish in time. Check again later.";
            }
        }
        catch (ServiceCallException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _jobs.Remove(file.Id);
        }
    }

    // ----- Drag-to-move (internal) -----

    public void BeginDrag(DragPayload payload)
    {
        _drag = payload;
        StateHasChanged();
    }

    public void EndDrag()
    {
        _drag = null;
        _dragOver = null;
        StateHasChanged();
    }

    public void DragEnter(FolderDto folder)
    {
        if (_drag is not null)
        {
            _dragOver = folder.Id;
            StateHasChanged();
        }
    }

    public async Task DropAsync(FolderDto target)
    {
        if (_drag is not { } drag)
        {
            return; // OS file drops are handled by explorerDrop.js
        }

        EndDrag();
        if (drag.ParentId == target.Id || drag.Id == target.Id)
        {
            return;
        }

        await RunAsync(async () =>
        {
            var request = drag.IsFolder
                ? new MoveRequest([drag.Id], [], target.Id)
                : new MoveRequest([], [drag.Id], target.Id);
            await Workspace.MoveAsync(request, CancellationToken.None);
            _expanded.Add(target.Id);
            await RefreshExpandedAsync();
        });
        StateHasChanged();
    }

    // ----- Uploads (callbacks from explorerDrop.js) -----

    private async Task PickAsync(ElementReference input)
    {
        if (_module is not null && TargetFolder is { } folder)
        {
            await _module.InvokeVoidAsync("pick", _root, input, folder.Id.ToString());
        }
    }

    [JSInvokable]
    public Task OnUploadQueued(int id, string path, long size)
    {
        _uploads.Add(new UploadRow(id, path, size));
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnUploadProgress(int id, long loaded, long total)
    {
        if (_uploads.Find(u => u.Id == id) is { } row)
        {
            row.Loaded = loaded;
        }

        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnUploadCompleted(int id, bool success, string? error)
    {
        if (_uploads.Find(u => u.Id == id) is { } row)
        {
            row.Done = true;
            row.Success = success;
            row.Error = error;
        }

        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnUploadBatchCompleted(string folderId) => InvokeAsync(async () =>
    {
        if (Guid.TryParse(folderId, out var id))
        {
            _expanded.Add(id);
        }

        await RunAsync(RefreshExpandedAsync);
        StateHasChanged();
    });

    private async Task SyncDefaultFolderAsync()
    {
        if (_module is not null && TargetFolder is { } folder)
        {
            await _module.InvokeVoidAsync("setDefaultFolder", _root, folder.Id.ToString());
        }
    }

    // ----- Helpers -----

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
        }
        catch (ServiceCallException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _root);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone.
            }
        }

        _self?.Dispose();
    }
}
