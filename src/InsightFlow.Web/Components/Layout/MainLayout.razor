@inherits LayoutComponentBase
@inject ThemeState Theme
@inject NavigationManager Navigation

<div class="flex h-screen flex-col">
    <header class="relative z-30 flex h-16 shrink-0 items-center gap-2 border-b border-line bg-white px-3 sm:gap-4 sm:px-6 dark:border-slate-800 dark:bg-slate-900">
        <button type="button" class="rounded-control p-2 text-ink-soft hover:bg-mist hover:text-brand-700 md:hidden"
                aria-label="Toggle menu" aria-expanded="@UiStyles.Aria(_mobileOpen)" aria-controls="side-panel" @onclick="() => _mobileOpen = !_mobileOpen">
            <Icon Name="menu" Class="size-5" />
        </button>
        <a href="/" class="flex shrink-0 items-center rounded-control" aria-label="Insight Flow home">
            <BrandLogo Size="size-9" Wordmark="false" />
            <span class="ml-2.5 hidden font-display text-lg font-bold tracking-tight text-ink sm:inline dark:text-white">Insight<span class="ml-1 font-semibold text-brand-600 dark:text-brand-300">Flow</span></span>
        </a>
        <div class="ml-auto flex shrink-0 items-center gap-2 text-sm text-slate-600 dark:text-slate-300">
            <button type="button" class="rounded-control px-2.5 py-1.5 text-base hover:bg-mist hover:text-brand-700 dark:hover:bg-slate-800"
                    title="Toggle dark mode" aria-label="Toggle dark mode" aria-pressed="@UiStyles.Aria(Theme.Dark)" @onclick="Theme.ToggleAsync">
                @(Theme.Dark ? "☀" : "☾")
            </button>
            <AuthorizeView>
                <div class="flex items-center gap-2 rounded-full bg-brand-50 py-1 pr-3 pl-1 dark:bg-slate-800">
                    <span class="grid size-8 place-items-center rounded-full bg-brand-600 text-xs font-semibold text-white" aria-hidden="true">@Initials(context.User.Identity?.Name)</span>
                    <span class="hidden font-medium text-ink sm:inline dark:text-slate-100" data-testid="user-name">@context.User.Identity?.Name</span>
                </div>
                <button type="button" class="rounded-control px-2.5 py-1.5 text-xs font-medium hover:bg-mist hover:text-brand-700 dark:hover:bg-slate-800" @onclick='() => Navigation.NavigateTo("/auth/signout", forceLoad: true)' data-testid="sign-out">Sign out</button>
            </AuthorizeView>
        </div>
    </header>

    <div class="relative flex min-h-0 flex-1">
        @if (_mobileOpen)
        {
            <div class="fixed inset-x-0 top-16 bottom-0 z-30 bg-slate-900/40 md:hidden" @onclick="() => _mobileOpen = false" aria-hidden="true"></div>
        }
        <aside id="side-panel" aria-label="Side panel"
               class="@SidePanelClass fixed top-16 bottom-0 left-0 z-40 flex w-64 shrink-0 flex-col border-r border-line bg-white transition-transform md:static md:z-auto md:translate-x-0 md:transition-[width] dark:border-slate-800 dark:bg-slate-900">
            <SideMenu Collapsed="_collapsed" OnNavigate="CloseMobile" />
            <div class="hidden border-t border-line p-2 md:block dark:border-slate-800">
                <button type="button" class="flex w-full items-center gap-3 rounded-control px-3 py-2 text-sm text-ink-soft hover:bg-mist hover:text-brand-700"
                        aria-label="@(_collapsed ? "Expand side panel" : "Collapse side panel")" aria-expanded="@UiStyles.Aria(!_collapsed)" @onclick="() => _collapsed = !_collapsed">
                    <Icon Name="chevron" Class="@($"size-5 transition-transform {(_collapsed ? "" : "rotate-180")}")" />
                    @if (!_collapsed)
                    {
                        <span>Collapse</span>
                    }
                </button>
            </div>
        </aside>

        <main class="min-h-0 min-w-0 flex-1 overflow-auto">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" class="fixed inset-x-0 bottom-0 z-50 hidden bg-amber-100 px-4 py-2 text-sm text-amber-900" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="underline">Reload</a>
</div>

@code {
    private bool _mobileOpen;
    private bool _collapsed;

    private string SidePanelClass =>
        (_mobileOpen ? "translate-x-0 shadow-xl " : "-translate-x-full ") + (_collapsed ? "md:w-[4.5rem]" : "md:w-64");

    private void CloseMobile() => _mobileOpen = false;

    private static string Initials(string? name)
    {
        var parts = (name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => string.Concat(parts[0][..1], parts[^1][..1]).ToUpperInvariant(),
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Theme.InitializeAsync();
            StateHasChanged();
        }
    }
}
