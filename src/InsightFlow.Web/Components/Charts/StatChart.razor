@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ThemeState Theme
@* Renders a ready-made ECharts option (dashboard statistics). The option is rebuilt per theme by the caller's factory. *@

<div @ref="_element" class="size-full min-h-64 @Class" role="img" aria-label="@AriaLabel"></div>

@code {
    private ElementReference _element;
    private IJSObjectReference? _module;
    private string? _renderedJson;

    /// <summary>Builds the option JSON for the current theme (true = dark).</summary>
    [Parameter, EditorRequired] public Func<bool, string> Option { get; set; } = default!;
    [Parameter, EditorRequired] public string AriaLabel { get; set; } = "";
    [Parameter] public string? Class { get; set; }

    protected override void OnInitialized() => Theme.Changed += OnThemeChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var json = Option(Theme.Dark);
        if (json == _renderedJson)
        {
            return;
        }

        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/echartsInterop.js");
        await _module.InvokeVoidAsync("render", _element, json);
        _renderedJson = json;
    }

    private void OnThemeChanged() => _ = InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Theme.Changed -= OnThemeChanged;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _element);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone; nothing to clean up in the browser.
            }
        }
    }
}
