@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ThemeState Theme
@* Renders a VizSpec + QueryResult with Vega-Lite (vega-embed). The spec JSON is built server-side by VegaLiteSpecBuilder. *@

<div @ref="_element" class="size-full min-h-64 @Class" role="img" aria-label="@AriaLabel"></div>

@code {
    private ElementReference _element;
    private IJSObjectReference? _module;
    private string? _renderedJson;

    [Parameter, EditorRequired] public VizSpec Spec { get; set; } = default!;
    [Parameter, EditorRequired] public QueryResult Result { get; set; } = default!;
    [Parameter] public string? Class { get; set; }

    private string AriaLabel => $"{Spec.Mark} chart";

    protected override void OnInitialized() => Theme.Changed += OnThemeChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var json = VegaLiteSpecBuilder.BuildJson(Spec, Result, Theme.Dark);
        if (json == _renderedJson)
        {
            return;
        }

        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/vegaInterop.js");
        await _module.InvokeVoidAsync("render", _element, json);
        _renderedJson = json;
    }

    private void OnThemeChanged() => _ = InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Theme.Changed -= OnThemeChanged;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _element);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone; nothing to clean up in the browser.
            }
        }
    }
}
