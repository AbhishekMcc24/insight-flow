@page "/workspace"
@inject IJSRuntime JS
@* The workspace: the Explorer (folders and uploads, stored on this machine) beside the spreadsheets panel, where uploaded Excel files are
   chosen, prepared with DuckDB and questioned. The pane is resizable (wwwroot/js/workspaceLayout.js). *@

<PageTitle>Workspace · Insight Flow</PageTitle>

<div @ref="_grid" class="if-workspace-grid grid h-full min-h-0 gap-px bg-slate-200 dark:bg-slate-800" style="grid-template-columns: @Columns">
    <Pane Title="Explorer" @bind-Collapsed="_explorerCollapsed">
        <ExplorerPane />
    </Pane>
    <div class="@SplitterClass" data-splitter="--pane-explorer" role="separator" aria-orientation="vertical"></div>

    <Pane Title="Spreadsheets" Collapsible="false">
        <SpreadsheetPanel />
    </Pane>
</div>

@code {
    private ElementReference _grid;
    private bool _explorerCollapsed;

    private string Columns => $"{(_explorerCollapsed ? "2.5rem" : "var(--pane-explorer)")} 4px minmax(0,1fr)";

    private string SplitterClass => _explorerCollapsed ? "w-1 bg-slate-200 dark:bg-slate-800" : "w-1 cursor-col-resize bg-slate-200 hover:bg-brand-400 dark:bg-slate-800";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/workspaceLayout.js");
            await module.InvokeVoidAsync("init", _grid);
        }
    }
}
