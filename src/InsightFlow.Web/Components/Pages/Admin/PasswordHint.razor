<div class="mt-1.5 flex items-center justify-between gap-3 text-xs text-ink-soft">
    <span>At least 8 characters. Passwords are stored hashed and cannot be viewed later.</span>
    <button type="button" class="shrink-0 font-medium text-brand-700 hover:underline dark:text-brand-300" aria-pressed="@UiStyles.Aria(Shown)" @onclick="OnToggle">@(Shown ? "Hide" : "Show")</button>
</div>

@code {
    [Parameter] public bool Shown { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }
}
