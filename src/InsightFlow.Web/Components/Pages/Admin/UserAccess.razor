@page "/admin/access"
@inject AdminApiClient Admin
@inject NavigationState Navigation
@* User Form Access (Sys-admin only): choose which menu entries each user can open. Sys-admins always see every menu. *@

<PageTitle>User Form Access · Insight Flow</PageTitle>

<div class="mx-auto max-w-6xl px-4 py-6 sm:px-8">
    <h1 class="text-2xl font-semibold tracking-tight text-ink dark:text-slate-100">User Form Access</h1>
    <p class="mt-1 text-sm text-ink-soft">Give or take away menu entries for a user. Checking a group checks everything inside it. Sys-admins always see every menu.</p>

    <div class="mt-4 flex flex-col gap-2">
        <Alert Message="@_error" />
        <Alert Message="@_notice" Error="false" OnDismiss="() => _notice = null" />
    </div>

    @if (_users is null || _menus is null)
    {
        <div class="flex justify-center p-8 text-brand-500"><Spinner /></div>
    }
    else
    {
        <div class="mt-4 grid gap-4 md:grid-cols-[18rem_minmax(0,1fr)]">
            <section class="if-card overflow-hidden" aria-labelledby="users-heading">
                <h2 id="users-heading" class="border-b border-line bg-brand-50 px-4 py-2.5 text-xs font-semibold tracking-wide text-ink-soft uppercase dark:bg-slate-800 dark:border-slate-800">Users</h2>
                @if (_users.Count == 0)
                {
                    <EmptyState Title="No users">Create users in User Config first.</EmptyState>
                }
                else
                {
                    <ul class="max-h-[60vh] divide-y divide-line overflow-auto dark:divide-slate-800" data-testid="access-users">
                        @foreach (var user in _users)
                        {
                            var selected = user.Id == _selected?.Id;
                            <li>
                                <button type="button" aria-current="@(selected ? "true" : null)" @onclick="() => SelectAsync(user)"
                                        class="@($"flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-mist {(selected ? "bg-brand-100 dark:bg-brand-900/40" : "")}")">
                                    <span class="grid size-9 shrink-0 place-items-center rounded-full bg-brand-600 text-xs font-semibold text-white" aria-hidden="true">@user.DisplayName[..1].ToUpperInvariant()</span>
                                    <span class="min-w-0 flex-1">
                                        <span class="block truncate text-sm font-medium text-ink dark:text-slate-100">@user.DisplayName</span>
                                        <span class="block truncate text-xs text-ink-soft">@UserRoleNames.Display(user.Role)@(user.IsActive ? "" : " · inactive")</span>
                                    </span>
                                </button>
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="if-card overflow-hidden" aria-labelledby="menus-heading">
                <div class="flex flex-wrap items-center gap-2 border-b border-line bg-brand-50 px-4 py-2.5 dark:bg-slate-800 dark:border-slate-800">
                    <h2 id="menus-heading" class="flex-1 text-xs font-semibold tracking-wide text-ink-soft uppercase">
                        @(_selected is null ? "Menu entries" : $"Menu entries for {_selected.DisplayName}")
                    </h2>
                    @if (_selected is not null)
                    {
                        <Button Small="true" Variant="ButtonVariant.Ghost" OnClick="() => SetAll(true)">Select all</Button>
                        <Button Small="true" Variant="ButtonVariant.Ghost" OnClick="() => SetAll(false)">Clear</Button>
                    }
                </div>
                @if (_selected is null)
                {
                    <EmptyState Title="Select a user">Pick a user on the left to see and change their menu access.</EmptyState>
                }
                else
                {
                    @if (_selected.Role == UserRoleNames.SysAdmin)
                    {
                        <p class="m-4 rounded-control border border-brand-200 bg-brand-50 px-3 py-2 text-sm text-brand-800 dark:bg-brand-900/30 dark:text-brand-100" role="note">
                            @_selected.DisplayName is a Sys-admin and always sees every menu entry. These checkboxes only matter if their role is changed.
                        </p>
                    }
                    <ul class="max-h-[55vh] divide-y divide-line overflow-auto dark:divide-slate-800" data-testid="access-menus">
                        @foreach (var (item, depth) in MenuTree.Flatten(_menus))
                        {
                            <li class="px-4 py-2.5" style="padding-left: @(1 + depth * 1.5)rem">
                                <label class="flex cursor-pointer items-center gap-3 text-sm">
                                    <input type="checkbox" class="size-4 accent-brand-600" checked="@_granted.Contains(item.Id)" @onchange="e => SetChecked(item, (bool)e.Value!)" />
                                    <span class="grid size-7 place-items-center rounded-control bg-brand-100 text-brand-700 dark:bg-brand-900/40"><Icon Name="@(item.Icon ?? "file")" /></span>
                                    <span class="font-medium text-ink dark:text-slate-100">@item.Name</span>
                                    @if (item.Route is null)
                                    {
                                        <span class="@UiStyles.Badge">Group</span>
                                    }
                                    @if (!item.IsActive)
                                    {
                                        <span class="text-xs text-ink-soft">(hidden)</span>
                                    }
                                </label>
                            </li>
                        }
                    </ul>
                    <div class="flex items-center justify-end gap-3 border-t border-line px-4 py-3 dark:border-slate-800">
                        @if (_dirty)
                        {
                            <span class="mr-auto text-sm text-ink-soft" role="status">Unsaved changes</span>
                        }
                        <Button Variant="ButtonVariant.Primary" Busy="_busy" Disabled="!_dirty" OnClick="SaveAsync">Save access</Button>
                    </div>
                }
            </section>
        </div>
    }
</div>

@code {
    private IReadOnlyList<UserDto>? _users;
    private IReadOnlyList<MenuItemDto>? _menus;
    private UserDto? _selected;
    private HashSet<Guid> _granted = [];
    private string? _error;
    private string? _notice;
    private bool _busy;
    private bool _dirty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _users = await Admin.ListUsersAsync(CancellationToken.None);
            _menus = await Admin.ListMenusAsync(CancellationToken.None);
        }
        catch (ServiceCallException ex)
        {
            _users ??= [];
            _menus ??= [];
            _error = ex.Message;
        }
    }

    private async Task SelectAsync(UserDto user)
    {
        try
        {
            var access = await Admin.GetUserAccessAsync(user.Id, CancellationToken.None);
            _granted = access.MenuItemIds.ToHashSet();
            _selected = user;
            _dirty = false;
            _error = null;
            _notice = null;
        }
        catch (ServiceCallException ex)
        {
            _error = ex.Message;
        }
    }

    private void SetChecked(MenuItemDto item, bool value)
    {
        foreach (var id in MenuTree.Subtree(item.Id, _menus ?? []))
        {
            _ = value ? _granted.Add(id) : _granted.Remove(id);
        }

        _dirty = true;
    }

    private void SetAll(bool value)
    {
        _granted = value ? (_menus ?? []).Select(m => m.Id).ToHashSet() : [];
        _dirty = true;
    }

    private async Task SaveAsync()
    {
        if (_selected is null)
        {
            return;
        }

        _busy = true;
        try
        {
            await Admin.SetUserAccessAsync(_selected.Id, new UserMenuAccessDto(_granted.ToList()), CancellationToken.None);
            _dirty = false;
            _error = null;
            _notice = $"Menu access for “{_selected.DisplayName}” was saved.";
            await Navigation.RefreshAsync(CancellationToken.None);
        }
        catch (ServiceCallException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
