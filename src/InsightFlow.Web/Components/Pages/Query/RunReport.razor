@using InsightFlow.Domain.Contracts.Agents
@* How an answer was produced: the steps the system followed, how long each took, and the AI tokens and estimated cost, in a collapsed panel
   whose header already shows the totals. Costs are estimates at the model's list price and cover only the AI calls. *@

<details class="group rounded-xl border border-line bg-white dark:border-slate-700 dark:bg-slate-900" data-testid="run-report">
    <summary class="flex cursor-pointer list-none flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3 [&::-webkit-details-marker]:hidden">
        <span class="grid size-6 shrink-0 place-items-center rounded-full bg-success text-xs font-bold text-white" aria-hidden="true">✓</span>
        <span class="text-sm font-semibold text-ink dark:text-slate-100">How this answer was produced</span>
        <span class="ml-auto flex flex-wrap items-center gap-2 text-xs text-ink-soft">
            <span class="@Chip" data-testid="report-steps">@Steps.Count step@(Steps.Count == 1 ? "" : "s")</span>
            <span class="@Chip" data-testid="report-time">@Seconds(TotalMs)</span>
            <span class="@Chip" data-testid="report-tokens">@TotalTokens.ToString("N0") tokens</span>
            <span class="@($"{Chip} font-semibold text-ink dark:text-slate-100")" data-testid="report-cost">@CostText</span>
            <Icon Name="chevron-down" Class="size-4 transition-transform group-open:rotate-180" />
        </span>
    </summary>

    <div class="border-t border-line px-4 py-3 dark:border-slate-700">
        <div class="overflow-x-auto">
            <table class="min-w-full text-sm" data-testid="report-table">
                <thead>
                    <tr class="text-left text-xs uppercase tracking-wide text-ink-soft">
                        <th scope="col" class="py-1.5 pr-3 font-semibold">Step</th>
                        <th scope="col" class="py-1.5 pr-3 font-semibold">What happened</th>
                        <th scope="col" class="py-1.5 pr-3 text-right font-semibold">Time</th>
                        <th scope="col" class="py-1.5 pr-3 text-right font-semibold">Tokens in / out</th>
                        <th scope="col" class="py-1.5 text-right font-semibold">Cost</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-line dark:divide-slate-800">
                    @for (var i = 0; i < Steps.Count; i++)
                    {
                        var s = Steps[i];
                        <tr class="align-top">
                            <td class="py-2 pr-3 whitespace-nowrap">
                                <span class="mr-1.5 inline-grid size-5 place-items-center rounded-full bg-brand-100 text-[11px] font-semibold text-brand-800 dark:bg-brand-900/40 dark:text-brand-100">@(i + 1)</span>
                                <span class="font-medium text-ink dark:text-slate-100">@s.Title</span>
                            </td>
                            <td class="py-2 pr-3 text-ink-soft">@s.Detail</td>
                            <td class="py-2 pr-3 text-right tabular-nums text-ink-soft whitespace-nowrap">@Seconds(s.DurationMs)</td>
                            <td class="py-2 pr-3 text-right tabular-nums text-ink-soft whitespace-nowrap">
                                @if (s.Usage is { TotalTokens: > 0 } u)
                                {
                                    <span>@u.InputTokens.ToString("N0") / @u.OutputTokens.ToString("N0")</span>
                                }
                                else
                                {
                                    <span aria-label="No AI used">—</span>
                                }
                            </td>
                            <td class="py-2 text-right tabular-nums whitespace-nowrap @(s.Usage is { CostUsd: null, TotalTokens: > 0 } ? "text-amber-700 dark:text-amber-300" : "text-ink-soft")">
                                @(s.Usage is null || s.Usage.TotalTokens == 0 ? "—" : s.Usage.CostUsd is { } c ? Money.Format(c) : "n/a")
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="border-t-2 border-line font-semibold text-ink dark:border-slate-700 dark:text-slate-100">
                        <td class="pt-2 pr-3" colspan="2">Total</td>
                        <td class="pt-2 pr-3 text-right tabular-nums whitespace-nowrap">@Seconds(TotalMs)</td>
                        <td class="pt-2 pr-3 text-right tabular-nums whitespace-nowrap">@InputTokens.ToString("N0") / @OutputTokens.ToString("N0")</td>
                        <td class="pt-2 text-right tabular-nums whitespace-nowrap">@CostText</td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <p class="mt-3 text-xs leading-relaxed text-ink-soft">
            @AiCalls AI call@(AiCalls == 1 ? "" : "s")@(Models.Count > 0 ? " · " + string.Join(", ", Models) : "").
            Cost is an estimate at the model's list price and covers the AI calls only; running the query on your own data has no AI cost.
            @if (MissingPrice)
            {
                <span class="text-amber-800 dark:text-amber-200"> No price is set for one of the models; add it under <span class="font-mono">Ai:Pricing</span> to include it in the total.</span>
            }
        </p>
    </div>
</details>

@code {
    private const string Chip = "rounded-full bg-slate-100 px-2.5 py-0.5 tabular-nums dark:bg-slate-800";

    /// <summary>The steps in the order they ran.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<ReportStep> Steps { get; set; } = [];

    private double TotalMs => Steps.Sum(s => s.DurationMs);

    private long InputTokens => Steps.Sum(s => s.Usage?.InputTokens ?? 0);

    private long OutputTokens => Steps.Sum(s => s.Usage?.OutputTokens ?? 0);

    private long TotalTokens => InputTokens + OutputTokens;

    private int AiCalls => Steps.Sum(s => s.Usage?.Calls ?? 0);

    private bool MissingPrice => Steps.Any(s => s.Usage is { TotalTokens: > 0, CostUsd: null });

    private IReadOnlyList<string> Models => [.. Steps.Select(s => s.Usage?.Model).Where(m => !string.IsNullOrWhiteSpace(m)).Select(m => m!).Distinct()];

    private string CostText => TotalTokens == 0 ? "$0.00" : MissingPrice && Steps.All(s => s.Usage?.CostUsd is null) ? "n/a" : (MissingPrice ? "≥ " : "~") + Money.Format(Steps.Sum(s => s.Usage?.CostUsd ?? 0m));

    private static string Seconds(double ms) => ms < 950 ? $"{ms:N0} ms" : $"{ms / 1000:0.0} s";
}
