@* A data type as a small colour-coded chip. The family (number, text, date…) is also spelled out for assistive technology and in the
   tooltip, so meaning never depends on colour alone. *@
<span class="@($"inline-flex max-w-full items-center gap-1.5 rounded-md px-2 py-0.5 font-mono text-xs font-medium {Style}")" title="@($"{Family}: {Type}")">
    <span class="size-1.5 shrink-0 rounded-full bg-current opacity-70" aria-hidden="true"></span>
    <span class="truncate">@Type</span>
    <span class="sr-only">(@Family)</span>
</span>

@code {
    [Parameter, EditorRequired] public string Type { get; set; } = "";

    private string Family => Classify(Type).Family;

    private string Style => Classify(Type).Style;

    private static (string Family, string Style) Classify(string type)
    {
        var t = type.ToLowerInvariant();
        bool Has(params string[] parts) => parts.Any(p => t.Contains(p, StringComparison.Ordinal));

        if (Has("uuid", "guid", "uniqueidentifier"))
        {
            return ("identifier", "bg-violet-100 text-violet-800 dark:bg-violet-900/40 dark:text-violet-200");
        }

        if (Has("bool", "bit", "tinyint(1)"))
        {
            return ("yes/no", "bg-fuchsia-100 text-fuchsia-800 dark:bg-fuchsia-900/40 dark:text-fuchsia-200");
        }

        if (Has("date", "time", "year"))
        {
            return ("date and time", "bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-200");
        }

        if (Has("int", "serial", "decimal", "numeric", "float", "double", "real", "money", "number"))
        {
            return ("number", "bg-brand-100 text-brand-700 dark:bg-brand-900/50 dark:text-brand-200");
        }

        if (Has("char", "text", "string", "clob", "enum", "set(", "citext"))
        {
            return ("text", "bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-200");
        }

        if (Has("json", "xml", "array", "binary", "blob", "bytea", "geometry", "geography"))
        {
            return ("structured", "bg-sky-100 text-sky-800 dark:bg-sky-900/40 dark:text-sky-200");
        }

        return ("other", "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300");
    }
}
