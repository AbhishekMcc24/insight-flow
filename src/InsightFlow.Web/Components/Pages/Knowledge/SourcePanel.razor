@inject ConnectionsApiClient Connections
@inject KnowledgeApiClient Knowledge
@* Step 2: bring tables in. Connect to a database server (fields or a pasted connection string), test it, save it, then pick a
   database, search its tables and preview their columns and data types before importing. Only catalog metadata is read, never rows. *@

<div class="grid items-start gap-5 xl:grid-cols-[27rem_minmax(0,1fr)]">

    @* ───────────────────────────── Connect ───────────────────────────── *@
    <section class="if-card overflow-hidden" aria-labelledby="connect-heading">
        <header class="relative overflow-hidden px-5 pt-5 pb-6 text-white" style="background: linear-gradient(135deg, var(--color-brand-700) 0%, var(--color-brand-500) 100%)">
            <span class="pointer-events-none absolute -top-10 -right-8 size-36 rounded-full bg-white/10" aria-hidden="true"></span>
            <span class="pointer-events-none absolute -right-2 bottom-[-3.2rem] size-28 rounded-full bg-white/10" aria-hidden="true"></span>
            <div class="relative flex items-center gap-3">
                <span class="grid size-11 place-items-center rounded-xl bg-white/15 ring-1 ring-white/30"><Icon Name="dataset" Class="size-6" /></span>
                <div>
                    <h2 id="connect-heading" class="text-lg font-bold">Connect a database</h2>
                    <p class="text-sm text-brand-100">SQL Server, PostgreSQL or MySQL</p>
                </div>
            </div>
        </header>

        <div class="-mt-3 rounded-t-2xl bg-white p-5 dark:bg-slate-900">
            <div role="tablist" aria-label="Connection source" class="grid grid-cols-2 gap-1 rounded-xl bg-brand-50 p-1 dark:bg-slate-800">
                <button type="button" role="tab" aria-selected="@UiStyles.Aria(_tab == "saved")" @onclick='() => _tab = "saved"'
                        class="@Segment(_tab == "saved")">Saved <span class="ml-1 text-xs opacity-70">(@(_connections?.Count ?? 0))</span></button>
                <button type="button" role="tab" aria-selected="@UiStyles.Aria(_tab == "new")" @onclick='() => _tab = "new"'
                        class="@Segment(_tab == "new")"><Icon Name="plus" Class="mr-1 inline size-4" />New connection</button>
            </div>

            <div class="mt-4 flex flex-col gap-2"><Alert Message="@_error" /><Alert Message="@_notice" Error="false" OnDismiss="() => _notice = null" /></div>

            @if (_tab == "saved")
            {
                @if (_connections is null)
                {
                    <div class="mt-4 space-y-2" aria-hidden="true">
                        <div class="h-14 animate-pulse rounded-xl bg-brand-50 dark:bg-slate-800"></div>
                        <div class="h-14 animate-pulse rounded-xl bg-brand-50 dark:bg-slate-800"></div>
                    </div>
                }
                else if (_connections.Count == 0)
                {
                    <div class="mt-4 rounded-xl border border-dashed border-line p-6 text-center">
                        <p class="text-sm font-medium text-ink dark:text-slate-100">No saved connections yet</p>
                        <p class="mt-1 text-sm text-ink-soft">Add your first database server to start browsing its tables.</p>
                        <div class="mt-3"><Button Variant="ButtonVariant.Primary" OnClick='() => _tab = "new"'><Icon Name="plus" /> New connection</Button></div>
                    </div>
                }
                else
                {
                    <ul class="mt-4 flex max-h-96 flex-col gap-2 overflow-auto" data-testid="saved-connections">
                        @foreach (var c in _connections)
                        {
                            var active = _active?.Id == c.Id;
                            <li class="flex items-stretch gap-2">
                                <button type="button" aria-pressed="@UiStyles.Aria(active)" @onclick="() => ConnectAsync(c)"
                                        class="@($"group flex min-w-0 flex-1 items-center gap-3 rounded-xl border p-3 text-left transition {(active ? "border-brand-600 bg-brand-50 shadow-card dark:bg-brand-900/30" : "border-line hover:border-brand-300 hover:bg-mist dark:border-slate-700")}")">
                                    <span class="@($"grid size-10 shrink-0 place-items-center rounded-lg text-xs font-bold {KindStyle(c.Kind)}")" aria-hidden="true">@KindInitials(c.Kind)</span>
                                    <span class="min-w-0 flex-1">
                                        <span class="block truncate text-sm font-semibold text-ink dark:text-slate-100">@c.Name</span>
                                        <span class="block truncate text-xs text-ink-soft">@KindLabel(c.Kind) · @ServerOf(c)</span>
                                    </span>
                                    @if (active)
                                    {
                                        <span class="inline-flex items-center gap-1 text-xs font-medium text-success"><span class="size-2 rounded-full bg-success" aria-hidden="true"></span> Connected</span>
                                    }
                                </button>
                                <button type="button" class="rounded-xl border border-line px-3 text-ink-soft transition hover:border-danger/50 hover:bg-red-50 hover:text-danger dark:border-slate-700 dark:hover:bg-red-950/30"
                                        aria-label="@($"Remove connection {c.Name}")" title="Remove connection" @onclick="() => _removing = c"><Icon Name="trash" Class="size-5" /></button>
                            </li>
                        }
                    </ul>
                }
            }
            else
            {
                <form class="mt-4 flex flex-col gap-4" @onsubmit="TestAsync" @onsubmit:preventDefault="true" autocomplete="off" data-testid="new-connection">
                    <fieldset>
                        <legend class="@UiStyles.Label">Database type</legend>
                        <div class="grid grid-cols-3 gap-2">
                            @foreach (var k in Kinds)
                            {
                                <button type="button" role="radio" aria-checked="@UiStyles.Aria(_kind == k)" @onclick="() => _kind = k"
                                        class="@($"flex flex-col items-center gap-1.5 rounded-xl border p-3 text-center text-xs font-medium transition {(_kind == k ? "border-brand-600 bg-brand-50 text-brand-700 shadow-card dark:bg-brand-900/30" : "border-line text-ink-soft hover:border-brand-300 hover:bg-mist dark:border-slate-700")}")">
                                    <span class="@($"grid size-9 place-items-center rounded-lg text-xs font-bold {KindStyle(k)}")" aria-hidden="true">@KindInitials(k)</span>
                                    @KindLabel(k)
                                </button>
                            }
                        </div>
                    </fieldset>

                    <label>
                        <span class="@UiStyles.Label">Connection name</span>
                        <input class="@UiStyles.Input" @bind="_name" maxlength="200" placeholder="e.g. Sales warehouse" />
                    </label>

                    <div role="tablist" aria-label="How to connect" class="flex gap-4 border-b border-line text-sm dark:border-slate-700">
                        <button type="button" role="tab" aria-selected="@UiStyles.Aria(_mode == "fields")" @onclick='() => _mode = "fields"' class="@Underline(_mode == "fields")">Connection details</button>
                        <button type="button" role="tab" aria-selected="@UiStyles.Aria(_mode == "connectionString")" @onclick='() => _mode = "connectionString"' class="@Underline(_mode == "connectionString")">Connection string</button>
                    </div>

                    @if (_mode == "connectionString")
                    {
                        <label>
                            <span class="@UiStyles.Label">Connection string</span>
                            <textarea class="@UiStyles.Input min-h-28 font-mono text-xs leading-relaxed" rows="4" spellcheck="false" autocomplete="off" @bind="_connectionString" @bind:event="oninput" placeholder="@ConnectionStringExample"></textarea>
                            <span class="mt-1 block text-xs text-ink-soft">Include the password in the string. Only the host, port, database, user, password and TLS options are used; everything else is ignored.</span>
                        </label>
                    }
                    else
                    {
                        <div class="grid gap-4 sm:grid-cols-3">
                            <label class="@(_kind == "SqlServer" ? "sm:col-span-3" : "sm:col-span-2")">
                                <span class="@UiStyles.Label">@(_kind == "SqlServer" ? "Server" : "Host")</span>
                                <input class="@UiStyles.Input" @bind="_host" maxlength="255" placeholder="@(_kind == "SqlServer" ? "myserver.database.windows.net" : "db.example.com")" />
                            </label>
                            @if (_kind != "SqlServer")
                            {
                                <label>
                                    <span class="@UiStyles.Label">Port</span>
                                    <input class="@UiStyles.Input" @bind="_port" inputmode="numeric" placeholder="@(_kind == "PostgreSql" ? "5432" : "3306")" />
                                </label>
                            }
                        </div>
                        <div class="grid gap-4 sm:grid-cols-2">
                            <label>
                                <span class="@UiStyles.Label">User</span>
                                <input class="@UiStyles.Input" @bind="_user" maxlength="128" autocomplete="off" />
                            </label>
                            <label>
                                <span class="@UiStyles.Label">Password</span>
                                <input type="password" class="@UiStyles.Input" @bind="_password" autocomplete="new-password" />
                            </label>
                        </div>
                        <label>
                            <span class="@UiStyles.Label">Database (optional)</span>
                            <input class="@UiStyles.Input" @bind="_databaseHint" maxlength="128" placeholder="Leave empty to choose from the server's list" />
                        </label>
                        @if (_kind == "SqlServer")
                        {
                            <label class="flex items-center gap-2 text-sm"><input type="checkbox" class="size-4 accent-brand-600" @bind="_trustCertificate" /> Trust the server certificate (development only)</label>
                        }
                        else
                        {
                            <label>
                                <span class="@UiStyles.Label">SSL mode</span>
                                <select class="@UiStyles.Input" @bind="_sslMode">
                                    @if (_kind == "PostgreSql")
                                    {
                                        <option value="require">require</option>
                                        <option value="prefer">prefer</option>
                                        <option value="verify-full">verify-full</option>
                                        <option value="disable">disable</option>
                                    }
                                    else
                                    {
                                        <option value="required">required</option>
                                        <option value="preferred">preferred</option>
                                        <option value="verify-full">verify-full</option>
                                        <option value="disable">disable</option>
                                    }
                                </select>
                            </label>
                        }
                    }

                    @if (_testResult is { } result)
                    {
                        <div role="status" data-testid="test-result"
                             class="@($"rounded-xl border p-3 text-sm {(result.Success ? "border-success/30 bg-emerald-50 text-emerald-900 dark:bg-emerald-950/40 dark:text-emerald-100" : "border-danger/30 bg-red-50 text-red-900 dark:bg-red-950/40 dark:text-red-100")}")">
                            <p class="flex items-start gap-2 font-medium"><span aria-hidden="true">@(result.Success ? "✓" : "✕")</span> <span>@(result.Success ? "Connected" : "Could not connect")</span></p>
                            <p class="mt-0.5 break-words opacity-90">@result.Message</p>
                            @if (result.Success && result.Databases.Count > 0)
                            {
                                <p class="mt-2 text-xs font-medium">@result.Databases.Count database@(result.Databases.Count == 1 ? "" : "s") found</p>
                                <ul class="mt-1 flex flex-wrap gap-1">
                                    @foreach (var d in result.Databases.Take(8))
                                    {
                                        <li class="rounded-md bg-white/70 px-2 py-0.5 font-mono text-xs dark:bg-slate-900/60">@d</li>
                                    }
                                    @if (result.Databases.Count > 8)
                                    {
                                        <li class="px-1 py-0.5 text-xs">+@(result.Databases.Count - 8) more</li>
                                    }
                                </ul>
                            }
                        </div>
                    }

                    <div class="flex flex-wrap items-center gap-2 pt-1">
                        <Button Type="submit" Busy="_testing" Disabled="_saving">Test connection</Button>
                        <Button Variant="ButtonVariant.Primary" OnClick="SaveAsync" Busy="_saving" Disabled="@(_testing || string.IsNullOrWhiteSpace(_name))" Title="@(string.IsNullOrWhiteSpace(_name) ? "Give the connection a name first" : null)">Save and connect</Button>
                    </div>
                    <p class="text-xs text-ink-soft">Passwords go to the secret store and are never shown again. Connections are read-only; only table definitions are read.</p>
                </form>
            }

            <div class="mt-5 border-t border-line pt-4 dark:border-slate-800">
                <p class="text-xs font-medium tracking-wide text-ink-soft uppercase">No database?</p>
                <div class="mt-2 flex items-center justify-between gap-3">
                    <p class="text-sm text-ink-soft">Use the datasets already in the Shared workspace.</p>
                    <Button OnClick="ImportDatasetsAsync" Busy="_importingDatasets" Disabled="@(_importing || _importingDatasets)">Import datasets</Button>
                </div>
            </div>
        </div>
    </section>

    @* ───────────────────────────── Explorer ───────────────────────────── *@
    <section class="if-card overflow-hidden" aria-labelledby="explore-heading">
        <header class="flex flex-wrap items-center gap-3 border-b border-line bg-brand-50/70 px-5 py-4 dark:border-slate-800 dark:bg-slate-800/50">
            <span class="grid size-10 place-items-center rounded-xl bg-brand-600 text-white shadow-card"><Icon Name="search" Class="size-5" /></span>
            <div class="min-w-0 flex-1">
                <h2 id="explore-heading" class="text-lg font-bold text-ink dark:text-slate-100">Browse and import</h2>
                <p class="truncate text-sm text-ink-soft">Choose a database, search its tables, and preview the columns before you import.</p>
            </div>
            @if (_active is not null)
            {
                <span class="inline-flex items-center gap-2 rounded-full bg-white px-3 py-1.5 text-sm shadow-card ring-1 ring-line dark:bg-slate-900" data-testid="connected-pill">
                    <span class="size-2 rounded-full bg-success" aria-hidden="true"></span>
                    <span class="font-medium text-ink dark:text-slate-100">@_active.Name</span>
                    <span class="text-ink-soft">· @KindLabel(_active.Kind)</span>
                </span>
                <Button Small="true" Variant="ButtonVariant.Ghost" OnClick="Disconnect">Disconnect</Button>
            }
        </header>

        @if (_active is null)
        {
            <div class="grid place-items-center px-6 py-20 text-center">
                <div class="relative mb-5 grid size-24 place-items-center rounded-3xl bg-brand-50 text-brand-600 dark:bg-slate-800" aria-hidden="true">
                    <Icon Name="dataset" Class="size-12" />
                    <span class="absolute -right-2 -bottom-2 grid size-9 place-items-center rounded-full bg-white shadow-card ring-1 ring-line dark:bg-slate-900"><Icon Name="search" Class="size-4 text-brand-700" /></span>
                </div>
                <h3 class="text-base font-semibold text-ink dark:text-slate-100">Nothing connected yet</h3>
                <p class="mt-1 max-w-sm text-sm text-ink-soft">Pick a saved connection or add a new one on the left. Then you can search its databases and tables and see every column and data type.</p>
            </div>
        }
        else
        {
            <div class="space-y-5 p-5">
                <div class="grid items-end gap-4 sm:grid-cols-[minmax(0,24rem)_1fr]">
                    <SearchSelect Label="Database" Items="_databases" Value="@_database" ValueChanged="OnDatabaseChangedAsync" Loading="_loadingDatabases"
                                  Placeholder="@(_loadingDatabases ? "Loading databases…" : "Search databases…")" EmptyText="No databases are visible to this login"
                                  Hint="@(_databases.Count > 0 ? $"{_databases.Count} database{(_databases.Count == 1 ? "" : "s")} on this server" : null)" />
                    @if (_database is not null && _tables is not null)
                    {
                        <dl class="flex flex-wrap gap-2 text-sm sm:justify-end" aria-label="Summary">
                            <div class="rounded-lg bg-brand-50 px-3 py-1.5 dark:bg-slate-800"><dt class="inline text-ink-soft">Tables </dt><dd class="inline font-semibold tabular-nums">@_tables.Count(t => t.Kind != "view")</dd></div>
                            <div class="rounded-lg bg-brand-50 px-3 py-1.5 dark:bg-slate-800"><dt class="inline text-ink-soft">Views </dt><dd class="inline font-semibold tabular-nums">@_tables.Count(t => t.Kind == "view")</dd></div>
                            <div class="rounded-lg bg-brand-100 px-3 py-1.5 text-brand-700 dark:bg-brand-900/40"><dt class="inline">Selected </dt><dd class="inline font-semibold tabular-nums">@_selected.Count</dd></div>
                        </dl>
                    }
                </div>

                @if (_database is null)
                {
                    <div class="rounded-2xl border border-dashed border-line p-10 text-center">
                        <p class="text-sm font-medium text-ink dark:text-slate-100">Pick a database to see its tables</p>
                        <p class="mt-1 text-sm text-ink-soft">Use the search box above; start typing to narrow the list.</p>
                    </div>
                }
                else
                {
                    <div class="grid gap-4 lg:grid-cols-[21rem_minmax(0,1fr)]">
                        @* Tables *@
                        <div class="flex h-[32rem] min-h-0 flex-col overflow-hidden rounded-2xl border border-line dark:border-slate-700">
                            <div class="space-y-2 border-b border-line p-3 dark:border-slate-700">
                                <label class="relative block">
                                    <span class="sr-only">Search tables</span>
                                    <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-ink-muted"><Icon Name="search" Class="size-4" /></span>
                                    <input type="search" class="@UiStyles.Input pl-9" placeholder="Search tables…" @bind="_tableFilter" @bind:event="oninput" data-testid="table-search" />
                                </label>
                                <div class="flex items-center justify-between text-xs text-ink-soft">
                                    <span aria-live="polite">@ShownTables.Count of @(_tables?.Count ?? 0) shown</span>
                                    <span>
                                        <button type="button" class="font-medium text-brand-700 hover:underline dark:text-brand-300" @onclick="() => SelectShown(true)">Select shown</button>
                                        <span aria-hidden="true"> · </span>
                                        <button type="button" class="font-medium text-brand-700 hover:underline dark:text-brand-300" @onclick="() => SelectShown(false)">Clear</button>
                                    </span>
                                </div>
                            </div>
                            <div class="min-h-0 flex-1 overflow-auto p-1.5">
                                @if (_loadingTables)
                                {
                                    <div class="space-y-1.5 p-1.5" aria-label="Loading tables">
                                        @for (var i = 0; i < 8; i++)
                                        {
                                            <div class="h-9 animate-pulse rounded-lg bg-brand-50 dark:bg-slate-800"></div>
                                        }
                                    </div>
                                }
                                else if (ShownTables.Count == 0)
                                {
                                    <p class="p-6 text-center text-sm text-ink-soft">@(_tables is { Count: 0 } ? "This database has no tables or views." : $"No tables match “{_tableFilter}”.")</p>
                                }
                                else
                                {
                                    <ul data-testid="source-tables">
                                        @foreach (var t in ShownTables)
                                        {
                                            var focused = _focus == t.Id;
                                            <li class="@($"group flex items-center gap-1 rounded-lg transition-colors {(focused ? "bg-brand-100 dark:bg-brand-900/40" : "hover:bg-mist dark:hover:bg-slate-800")}")">
                                                <label class="grid size-9 shrink-0 cursor-pointer place-items-center" title="Select @t.Id for import">
                                                    <span class="sr-only">Select @t.Id for import</span>
                                                    <input type="checkbox" class="size-4 accent-brand-600" checked="@_selected.Contains(t.Id)" @onchange="e => Toggle(t.Id, (bool)e.Value!)" />
                                                </label>
                                                <button type="button" aria-current="@(focused ? "true" : null)" @onclick="() => FocusAsync(t)"
                                                        class="flex min-w-0 flex-1 items-center gap-2 py-2 pr-2 text-left text-sm">
                                                    <Icon Name="@(t.Kind == "view" ? "file" : "dataset")" Class="@($"size-4 {(focused ? "text-brand-700" : "text-ink-muted")}")" />
                                                    <span class="min-w-0 flex-1 truncate @(focused ? "font-semibold text-brand-700 dark:text-brand-200" : "text-ink dark:text-slate-100")">@HighlightName(t)</span>
                                                    @if (t.Kind == "view")
                                                    {
                                                        <span class="@UiStyles.Badge">view</span>
                                                    }
                                                </button>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                        </div>

                        @* Columns *@
                        <div class="flex h-[32rem] min-h-0 flex-col overflow-hidden rounded-2xl border border-line dark:border-slate-700" data-testid="column-preview">
                            @if (_focus is null)
                            {
                                <div class="grid flex-1 place-items-center p-8 text-center">
                                    <div>
                                        <span class="mx-auto mb-3 grid size-14 place-items-center rounded-2xl bg-brand-50 text-brand-600 dark:bg-slate-800" aria-hidden="true"><Icon Name="menu" Class="size-7" /></span>
                                        <p class="text-sm font-medium text-ink dark:text-slate-100">Select a table to preview its columns</p>
                                        <p class="mt-1 text-sm text-ink-soft">You will see each column's data type, whether it can be empty, and its keys.</p>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="flex flex-wrap items-center gap-3 border-b border-line bg-brand-50/60 px-4 py-3 dark:border-slate-700 dark:bg-slate-800/50">
                                    <div class="min-w-0 flex-1">
                                        <h3 class="truncate text-sm font-semibold text-ink dark:text-slate-100">@_focus</h3>
                                        <p class="text-xs text-ink-soft">@(_loadingColumns ? "Reading columns…" : $"{Columns.Count} column{(Columns.Count == 1 ? "" : "s")}{(Columns.Count(c => c.IsPrimaryKey) is var pk and > 0 ? $" · {pk} key" : "")}{(_focusForeignKeys.Count > 0 ? $" · {_focusForeignKeys.Count} foreign key{(_focusForeignKeys.Count == 1 ? "" : "s")}" : "")}")</p>
                                    </div>
                                    <label class="flex items-center gap-2 text-sm">
                                        <input type="checkbox" class="size-4 accent-brand-600" checked="@_selected.Contains(_focus)" @onchange="e => Toggle(_focus, (bool)e.Value!)" />
                                        Import this table
                                    </label>
                                </div>
                                <div class="min-h-0 flex-1 overflow-auto">
                                    @if (_loadingColumns)
                                    {
                                        <div class="space-y-2 p-4" aria-label="Loading columns">
                                            @for (var i = 0; i < 9; i++)
                                            {
                                                <div class="h-8 animate-pulse rounded-lg bg-brand-50 dark:bg-slate-800"></div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <table class="min-w-full border-separate border-spacing-0 text-sm" data-testid="columns-grid">
                                            <caption class="sr-only">Columns of @_focus</caption>
                                            <thead>
                                                <tr class="sticky top-0 z-10 bg-white/95 backdrop-blur dark:bg-slate-900/95">
                                                    <th scope="col" class="@($"{UiStyles.TableHead} w-10 border-b border-line text-right")">#</th>
                                                    <th scope="col" class="@($"{UiStyles.TableHead} border-b border-line")">Column</th>
                                                    <th scope="col" class="@($"{UiStyles.TableHead} border-b border-line")">Data type</th>
                                                    <th scope="col" class="@($"{UiStyles.TableHead} border-b border-line")">Nullable</th>
                                                    <th scope="col" class="@($"{UiStyles.TableHead} border-b border-line")">Keys</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @for (var i = 0; i < Columns.Count; i++)
                                                {
                                                    var c = Columns[i];
                                                    var fk = _focusForeignKeys.FirstOrDefault(f => string.Equals(f.FromColumn, c.Name, StringComparison.OrdinalIgnoreCase));
                                                    <tr class="transition-colors hover:bg-mist dark:hover:bg-slate-800/60">
                                                        <td class="@($"{UiStyles.TableCell} w-10 border-b border-line/60 text-right text-xs text-ink-muted tabular-nums")">@(i + 1)</td>
                                                        <td class="@($"{UiStyles.TableCell} border-b border-line/60 font-mono text-[13px] {(c.IsPrimaryKey ? "font-semibold text-ink dark:text-white" : "")}")">@c.Name</td>
                                                        <td class="@($"{UiStyles.TableCell} border-b border-line/60")"><DataTypeChip Type="@c.DataType" /></td>
                                                        <td class="@($"{UiStyles.TableCell} border-b border-line/60 text-xs {(c.IsNullable ? "text-ink-soft" : "font-medium text-ink dark:text-slate-100")}")">@(c.IsNullable ? "NULL" : "NOT NULL")</td>
                                                        <td class="@($"{UiStyles.TableCell} border-b border-line/60")">
                                                            <span class="flex flex-wrap items-center gap-1.5">
                                                                @if (c.IsPrimaryKey)
                                                                {
                                                                    <span class="inline-flex items-center gap-1 rounded-md bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-800 dark:bg-amber-900/40 dark:text-amber-200" title="Primary key"><Icon Name="key" Class="size-3.5" /> PK</span>
                                                                }
                                                                @if (fk is not null)
                                                                {
                                                                    <span class="inline-flex items-center gap-1 rounded-md bg-sky-100 px-2 py-0.5 text-xs font-medium text-sky-800 dark:bg-sky-900/40 dark:text-sky-200" title="@($"Foreign key to {fk.ToTable}.{fk.ToColumn}")"><Icon Name="graph" Class="size-3.5" /> FK → @fk.ToTable.@fk.ToColumn</span>
                                                                }
                                                            </span>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <footer class="sticky bottom-0 flex flex-wrap items-center gap-3 border-t border-line bg-white/90 px-5 py-3 backdrop-blur dark:border-slate-800 dark:bg-slate-900/90">
                <div class="min-w-0 flex-1" aria-live="polite">
                    @if (_selected.Count == 0)
                    {
                        <p class="text-sm text-ink-soft">Tick the tables you want in the knowledge base.</p>
                    }
                    else
                    {
                        <ul class="flex flex-wrap items-center gap-1.5">
                            @foreach (var id in _selected.Take(4))
                            {
                                <li class="inline-flex max-w-48 items-center gap-1 rounded-full bg-brand-100 py-0.5 pr-1 pl-2.5 text-xs font-medium text-brand-700 dark:bg-brand-900/40 dark:text-brand-200">
                                    <span class="truncate">@id</span>
                                    <button type="button" class="rounded-full p-0.5 hover:bg-brand-200" aria-label="Remove @id from the selection" @onclick="() => Toggle(id, false)"><Icon Name="close" Class="size-3" /></button>
                                </li>
                            }
                            @if (_selected.Count > 4)
                            {
                                <li class="text-xs text-ink-soft">+@(_selected.Count - 4) more</li>
                            }
                        </ul>
                    }
                </div>
                <Button Variant="ButtonVariant.Ghost" OnClick="ClearSelection" Disabled="@(_selected.Count == 0)">Clear</Button>
                <Button Variant="ButtonVariant.Primary" OnClick="ImportAsync" Busy="_importing" Disabled="@(_selected.Count == 0 || _database is null || _importing)">
                    Import @(_selected.Count == 0 ? "tables" : $"{_selected.Count} table{(_selected.Count == 1 ? "" : "s")}")
                </Button>
            </footer>
        }
    </section>
</div>

<Modal Title="Remove connection" Open="_removing is not null" OpenChanged="_ => _removing = null">
    <p class="text-sm">
        Remove <strong>@_removing?.Name</strong>? Its saved password is deleted too.
        Tables you already imported stay in the knowledge base.
    </p>
    <div class="mt-5 flex justify-end gap-2">
        <Button OnClick="() => _removing = null">Cancel</Button>
        <Button Variant="ButtonVariant.Danger" Busy="_removingBusy" OnClick="RemoveAsync">Remove connection</Button>
    </div>
</Modal>

@code {
    private static readonly string[] Kinds = ["SqlServer", "PostgreSql", "MySql"];

    private IReadOnlyList<ConnectionDto>? _connections;
    private ConnectionDto? _active;
    private IReadOnlyList<string> _databases = [];
    private string? _database;
    private IReadOnlyList<SourceTableDto>? _tables;
    private readonly HashSet<string> _selected = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, SourceSchemaDto> _schemas = new(StringComparer.OrdinalIgnoreCase);
    private string? _focus;
    private List<SourceForeignKeyDto> _focusForeignKeys = [];
    private string _tableFilter = "";

    private string _tab = "saved";
    private string _kind = "SqlServer";
    private string _mode = "fields";
    private string _name = "";
    private string _host = "";
    private string _port = "";
    private string _databaseHint = "";
    private string _user = "";
    private string _password = "";
    private string _connectionString = "";
    private string _sslMode = "require";
    private bool _trustCertificate;
    private SourceTestResultDto? _testResult;

    private bool _testing;
    private bool _saving;
    private bool _loadingDatabases;
    private bool _loadingTables;
    private bool _loadingColumns;
    private bool _importing;
    private bool _importingDatasets;
    private ConnectionDto? _removing;
    private bool _removingBusy;
    private string? _error;
    private string? _notice;

    [Parameter] public EventCallback OnImported { get; set; }

    private IReadOnlyList<SourceColumnDto> Columns =>
        _focus is not null && _schemas.TryGetValue(_focus, out var s) && s.Tables.FirstOrDefault() is { } t ? t.Columns : [];

    private List<SourceTableDto> ShownTables =>
        [.. (_tables ?? []).Where(t => _tableFilter.Trim().Length == 0 || t.Id.Contains(_tableFilter.Trim(), StringComparison.OrdinalIgnoreCase))];

    private string ConnectionStringExample => _kind switch
    {
        "PostgreSql" => "Host=db.example.com;Port=5432;Database=sales;Username=reader;Password=…;SSL Mode=Require",
        "MySql" => "Server=db.example.com;Port=3306;Database=sales;User ID=reader;Password=…;SslMode=Required",
        _ => "Server=tcp:myserver.database.windows.net,1433;Initial Catalog=sales;User ID=reader;Password=…;Encrypt=True",
    };

    protected override async Task OnInitializedAsync() => await LoadConnectionsAsync();

    // ── presentation helpers ──────────────────────────────────────────────────────────────────────

    private static string KindLabel(string kind) => kind switch { "SqlServer" => "SQL Server", "PostgreSql" => "PostgreSQL", "MySql" => "MySQL", _ => kind };

    private static string KindInitials(string kind) => kind switch { "SqlServer" => "SQL", "PostgreSql" => "PG", "MySql" => "My", _ => "DB" };

    private static string KindStyle(string kind) => kind switch
    {
        "SqlServer" => "bg-brand-100 text-brand-700 dark:bg-brand-900/50 dark:text-brand-200",
        "PostgreSql" => "bg-sky-100 text-sky-800 dark:bg-sky-900/40 dark:text-sky-200",
        "MySql" => "bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-200",
        _ => "bg-slate-100 text-slate-700",
    };

    private static string ServerOf(ConnectionDto c) =>
        c.Settings.TryGetValue("server", out var s) ? s : c.Settings.TryGetValue("host", out var h) ? h : "";

    private static string Segment(bool active) =>
        "rounded-lg px-3 py-2 text-sm font-medium transition " + (active ? "bg-white text-brand-700 shadow-card dark:bg-slate-900" : "text-ink-soft hover:text-brand-700");

    private static string Underline(bool active) =>
        "-mb-px border-b-2 px-1 pb-2 font-medium transition " + (active ? "border-brand-600 text-brand-700 dark:text-brand-300" : "border-transparent text-ink-soft hover:text-brand-700");

    private RenderFragment HighlightName(SourceTableDto t) => __builder =>
    {
        var filter = _tableFilter.Trim();
        var at = filter.Length == 0 ? -1 : t.Id.IndexOf(filter, StringComparison.OrdinalIgnoreCase);
        if (at < 0)
        {
            <span>@t.Id</span>
        }
        else
        {
            <span>@t.Id[..at]<mark class="rounded bg-brand-200/70 px-0 text-inherit">@t.Id.Substring(at, filter.Length)</mark>@t.Id[(at + filter.Length)..]</span>
        }
    };

    // ── connections ───────────────────────────────────────────────────────────────────────────────

    private async Task LoadConnectionsAsync()
    {
        try
        {
            var all = await Connections.ListAsync(CancellationToken.None);
            _connections = all.Where(c => Array.IndexOf(Kinds, c.Kind) >= 0).ToList();
            if (_connections.Count == 0)
            {
                _tab = "new";
            }
        }
        catch (ServiceCallException ex)
        {
            _connections ??= [];
            _error = ex.Message;
        }
    }

    private SourceConnectionRequest Request() =>
        new(_kind, _mode, _name, _host, _port, _databaseHint, _user, _password, _connectionString, _sslMode, _trustCertificate);

    private async Task TestAsync()
    {
        _testing = true;
        _error = null;
        _testResult = null;
        try
        {
            _testResult = await Knowledge.TestSourceAsync(Request(), CancellationToken.None);
        }
        catch (ServiceCallException ex)
        {
            _testResult = new SourceTestResultDto(false, ex.Message, []);
        }
        finally
        {
            _testing = false;
        }
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;
        try
        {
            var created = await Knowledge.SaveSourceAsync(Request(), CancellationToken.None);
            (_password, _connectionString, _testResult) = ("", "", null);
            await LoadConnectionsAsync();
            _tab = "saved";
            _notice = $"Connection “{created.Name}” saved.";
            await ConnectAsync(_connections?.FirstOrDefault(c => c.Id == created.Id) ?? created);
        }
        catch (ServiceCallException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ConnectAsync(ConnectionDto connection)
    {
        _active = connection;
        _error = null;
        _database = null;
        _tables = null;
        _focus = null;
        _focusForeignKeys = [];
        _databases = [];
        _selected.Clear();
        _schemas.Clear();
        _tableFilter = "";
        _loadingDatabases = true;
        try
        {
            _databases = await Knowledge.SourceDatabasesAsync(connection.Id, CancellationToken.None);
            var preset = connection.Settings.TryGetValue("database", out var d) ? d : null;
            if (preset is not null && _databases.Contains(preset, StringComparer.OrdinalIgnoreCase))
            {
                await OnDatabaseChangedAsync(_databases.First(x => string.Equals(x, preset, StringComparison.OrdinalIgnoreCase)));
            }
        }
        catch (ServiceCallException ex)
        {
            _error = ex.Message;
            _active = null;
        }
        finally
        {
            _loadingDatabases = false;
        }
    }

private async Task RemoveAsync()    {        if (_removing is null)        {            return;        }        _removingBusy = true;        _error = null;        try        {            var removed = _removing;            await Knowledge.DeleteSourceAsync(removed.Id, CancellationToken.None);            if (_active?.Id == removed.Id)            {                Disconnect();            }            _removing = null;            await LoadConnectionsAsync();            _notice = $"Connection “{removed.Name}” was removed.";        }        catch (ServiceCallException ex)        {            _error = ex.Message;            _removing = null;        }        finally        {            _removingBusy = false;        }    }
    private void Disconnect()
    {
        (_active, _database, _tables, _focus) = (null, null, null, null);
        _databases = [];
        _selected.Clear();
        _schemas.Clear();
    }

    // ── browsing ──────────────────────────────────────────────────────────────────────────────────

    private async Task OnDatabaseChangedAsync(string? database)
    {
        _database = database;
        _tables = null;
        _focus = null;
        _focusForeignKeys = [];
        _selected.Clear();
        _schemas.Clear();
        _tableFilter = "";
        if (database is null || _active is null)
        {
            return;
        }

        _loadingTables = true;
        _error = null;
        try
        {
            _tables = await Knowledge.SourceTablesAsync(_active.Id, database, CancellationToken.None);
        }
        catch (ServiceCallException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loadingTables = false;
        }
    }

    private async Task FocusAsync(SourceTableDto table)
    {
        _focus = table.Id;
        _focusForeignKeys = [];
        if (_active is null || _database is null)
        {
            return;
        }

        if (!_schemas.TryGetValue(table.Id, out var schema))
        {
            _loadingColumns = true;
            try
            {
                schema = await Knowledge.DescribeSourceAsync(_active.Id, new SourceDescribeRequest(_database, [table.Id]), CancellationToken.None);
                _schemas[table.Id] = schema;
            }
            catch (ServiceCallException ex)
            {
                _error = ex.Message;
                return;
            }
            finally
            {
                _loadingColumns = false;
            }
        }

        if (_focus == table.Id)
        {
            _focusForeignKeys = schema.ForeignKeys.Where(f => string.Equals(f.FromTable, table.Id, StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

    private void Toggle(string id, bool on) => _ = on ? _selected.Add(id) : _selected.Remove(id);

    private void SelectShown(bool on)
    {
        foreach (var t in ShownTables)
        {
            _ = on ? _selected.Add(t.Id) : _selected.Remove(t.Id);
        }
    }

    private void ClearSelection() => _selected.Clear();

    // ── importing ─────────────────────────────────────────────────────────────────────────────────

    private async Task ImportAsync()
    {
        if (_active is null || _database is null)
        {
            return;
        }

        _importing = true;
        _error = null;
        try
        {
            var result = await Knowledge.ImportTablesAsync(new ImportTablesRequest(_active.Id, _selected.ToList(), _database), CancellationToken.None);
            _notice = Describe(result);
            _selected.Clear();
            await OnImported.InvokeAsync();
        }
        catch (ServiceCallException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _importing = false;
        }
    }

    private async Task ImportDatasetsAsync()
    {
        _importingDatasets = true;
        _error = null;
        try
        {
            _notice = Describe(await Knowledge.ImportDatasetsAsync(CancellationToken.None));
            await OnImported.InvokeAsync();
        }
        catch (ServiceCallException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _importingDatasets = false;
        }
    }

    private static string Describe(ImportResultDto r) =>
        $"Imported {r.Tables} tables with {r.Columns} columns and {r.Relationships} foreign keys" + (r.Skipped > 0 ? $"; {r.Skipped} were already in the knowledge base." : ".");
}
