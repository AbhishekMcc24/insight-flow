            break;
        case "dataset":
            <path d="M10 2c3.9 0 7 1.3 7 3s-3.1 3-7 3-7-1.3-7-3 3.1-3 7-3Zm7 5.2V10c0 1.7-3.1 3-7 3s-7-1.3-7-3V7.2C4.5 8.3 7.1 9 10 9s5.5-.7 7-1.8Zm0 5V15c0 1.7-3.1 3-7 3s-7-1.3-7-3v-2.8C4.5 13.3 7.1 14 10 14s5.5-.7 7-1.8Z" />
