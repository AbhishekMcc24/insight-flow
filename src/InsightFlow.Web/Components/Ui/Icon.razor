        default:
            <path d="M5 2h6l4 4v10.5A1.5 1.5 0 0 1 13.5 18h-8A1.5 1.5 0 0 1 4 16.5v-13A1.5 1.5 0 0 1 5.5 2H5Zm6 1v3.5h3.5L11 3Z" />
