@* A workspace pane: header with title/actions and a collapse toggle; a collapsed pane shrinks to a vertical rail. *@
<section class="flex h-full min-h-0 min-w-0 flex-col overflow-hidden bg-white dark:bg-slate-900" aria-label="@Title">
    @if (Collapsed)
    {
        <button type="button" class="flex h-full w-full flex-col items-center gap-2 py-3 text-xs font-medium text-slate-500 hover:bg-slate-50 dark:hover:bg-slate-800"
                title="Expand @Title" @onclick="Toggle">
            <span aria-hidden="true">»</span>
            <span class="[writing-mode:vertical-rl]">@Title</span>
        </button>
    }
    else
    {
        <header class="flex h-10 shrink-0 items-center gap-1 border-b border-slate-200 px-3 dark:border-slate-800">
            <h2 class="flex-1 truncate text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">@Title</h2>
            @Actions
            @if (Collapsible)
            {
                <button type="button" class="rounded px-1 text-slate-400 hover:bg-slate-100 hover:text-slate-700 dark:hover:bg-slate-800" title="Collapse @Title" @onclick="Toggle">«</button>
            }
        </header>
        <div class="min-h-0 flex-1 overflow-auto">@ChildContent</div>
    }
</section>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public bool Collapsible { get; set; } = true;
    [Parameter] public bool Collapsed { get; set; }
    [Parameter] public EventCallback<bool> CollapsedChanged { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private Task Toggle() => CollapsedChanged.InvokeAsync(!Collapsed);
}
