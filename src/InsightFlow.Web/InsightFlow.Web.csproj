<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Blazor Web App (Interactive Server) styled with Tailwind CSS v4; charts rendered by Apache ECharts.
       References Contracts + ServiceDefaults only and talks to services over HTTP. Owned by Developer 2 after handoff.
       Front-end assets are built from npm on every build (see the FrontendBuild target below and docs/adr/0009). -->
  <PropertyGroup>
    <UserSecretsId>insightflow-web-6a3c</UserSecretsId>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\InsightFlow.Contracts\InsightFlow.Contracts.csproj" />
    <ProjectReference Include="..\InsightFlow.ServiceDefaults\InsightFlow.ServiceDefaults.csproj" />
  </ItemGroup>

  <!-- ===================================================================================== -->
  <!-- Front-end build: npm ci -> Tailwind CLI -> copy the vendored ECharts bundle into wwwroot. -->
  <!-- Set SkipNpm=true to build without Node (generated CSS/JS must then already exist).      -->
  <!-- ===================================================================================== -->
  <PropertyGroup>
    <SkipNpm Condition="'$(SkipNpm)' == ''">false</SkipNpm>
    <_RunFrontendBuild>false</_RunFrontendBuild>
    <_RunFrontendBuild Condition="'$(SkipNpm)' != 'true' and '$(DesignTimeBuild)' != 'true'">true</_RunFrontendBuild>
    <_NpmInstallStamp>$(MSBuildProjectDirectory)/node_modules/.package-lock.json</_NpmInstallStamp>
    <_TailwindOutput>wwwroot/css/app.css</_TailwindOutput>
    <_ChartLibOutputDir>wwwroot/lib/echarts/</_ChartLibOutputDir>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="package.json;package-lock.json;node_modules/**" />
    <None Remove="node_modules/**" />
    <None Include="package.json;package-lock.json" />
    <_TailwindSources Include="Styles/**/*.css;Components/**/*.razor;Components/**/*.cs;wwwroot/js/**/*.js" />
  </ItemGroup>

  <Target Name="NpmInstall" Condition="'$(_RunFrontendBuild)' == 'true'"
          Inputs="package.json;package-lock.json" Outputs="$(_NpmInstallStamp)">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Touch Files="$(_NpmInstallStamp)" />
  </Target>

  <Target Name="TailwindBuild" Condition="'$(_RunFrontendBuild)' == 'true'" DependsOnTargets="NpmInstall"
          Inputs="@(_TailwindSources);package-lock.json" Outputs="$(_TailwindOutput)">
    <Exec Command="npm run build:css --silent" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <Target Name="CopyChartAssets" Condition="'$(_RunFrontendBuild)' == 'true'" DependsOnTargets="NpmInstall">
    <ItemGroup>
      <!-- Apache-2.0: the LICENSE and NOTICE files travel with the redistributed bundle. -->
      <_ChartLibFiles Include="node_modules/echarts/dist/echarts.min.js;node_modules/echarts/LICENSE;node_modules/echarts/NOTICE" />
    </ItemGroup>
    <Copy SourceFiles="@(_ChartLibFiles)" DestinationFolder="$(_ChartLibOutputDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Generated files do not exist at evaluation time on a clean clone, so register them as static web assets here. -->
  <Target Name="FrontendBuild" BeforeTargets="BeforeBuild" DependsOnTargets="TailwindBuild;CopyChartAssets">
    <ItemGroup>
      <_GeneratedWebAssets Include="$(_TailwindOutput);$(_ChartLibOutputDir)*" />
      <Content Include="@(_GeneratedWebAssets)" Exclude="@(Content)" />
    </ItemGroup>
  </Target>
</Project>
